# ============================================================
# 压测目标配置（run.sh 启动时自动加载；命令行已设的环境变量优先）
# ============================================================

# 压测流量打谁
# 正式压测填 new-api 地址（http://localhost:3000）
# 调试压测工具本身可直打 mock 上游（http://localhost:8787）
BASE_URL=http://localhost:3000

# 压测目标的鉴权令牌
# 打 new-api 时填 new-api 后台建的令牌（sk- 开头）
# 直打 mock 时随便填，mock 不校验
API_KEY=sk-your-new-api-token-here

# 多账号并发测试（逗号分隔多个令牌；设了就覆盖 API_KEY，按轮询分配）
# API_KEYS=sk-token-a,sk-token-b

# 请求总时限（k6 http timeout；长输出流式要够长，默认 120s）
REQ_TIMEOUT_MS=120s

# 完整 AWS 报告推荐使用 bash run-aws.sh；普通 run.sh 也会读取这些开关。
# AWS 登录使用 infra/mock/connection.local.json 指定的本地 Profile，勿在本文件复制临时凭据。
AWS_METRICS=0
STREAM_METER=0

# Reporting: keep warmup shorter than each fixed-load interval.
WARMUP_DURATION=15s
STRESS_RAMP_DURATION=10s
# 压力测试结束后降回首档并观察恢复；0s 表示不增加恢复阶段。
STRESS_RECOVERY_DURATION=3m
# mock | real | unknown (metadata only; does not change routing)
UPSTREAM_MODE=unknown
# Optional exploratory gates. Empty = no automatic numeric acceptance.
# MIN_SUCCESS_RATE=0.99
# MAX_SUCCESS_P95_MS=15000
# MIN_STAGE_SAMPLES=200
# MIN_STEADY_SECONDS=60
# TEST_CONTEXT_FILE=test-context.json

# 混合流量抽哪些模型（逗号分隔，必须都在 new-api 渠道里配过）
MODELS=gpt-6-astra,claude-sonnet-5

# ============================================================
# 场景参数（可选，不设则用默认值）
# ============================================================

# soak 场景（稳态测试）
SOAK_VUS=2000        # 并发用户数（最低配置 2000 用户）
SOAK_DURATION=2m     # 持续时间

# stress 场景（压力测试）
STRESS_START_VUS=2000 # 首档 VU
STRESS_MAX_VUS=6000   # 五档：2000、3000、4000、5000、6000

# spike 场景（尖峰测试）
SPIKE_VUS=2000       # 冲击 VU

# mixed 场景（混合流量）
MIXED_VUS=2000       # 实际运行的固定并发 VU
MIXED_DURATION=3m    # 持续时间，必须大于 WARMUP_DURATION


# ============================================================
# 真实请求样本与长流场景（可选）
# ============================================================
# PROMPTS_FILE: 每行一条真实 prompt 文本（从 new-api 日志脱敏导出）。
# 设置后所有场景默认改用真实样本；请求体大小/上行流量才贴近生产。
# PROMPTS_FILE=/path/to/real-prompts.txt
# PROMPT_KIND=real          # short | long | real（不设则 PROMPTS_FILE 存在即 real）
# STREAM_RATIO=0.5          # 流式请求比例（stress/soak/spike）
# MOCK_MAX_TOKENS=3500      # mock 输出 token 上限；3500×20ms≈70s 长流
LONG_VUS=2000
# 长流场景: LONG_VUS=2000 LONG_DURATION=5m REQ_TIMEOUT_MS=3m bash run-aws.sh longstream
