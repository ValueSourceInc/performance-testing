# ============================================================
# 压测目标配置（run.sh 启动时自动加载，已设环境变量优先级更高）
# ============================================================

# 压测流量打谁
# 正式压测填 new-api 地址（http://localhost:3000）
# 调试压测工具本身可直打 mock 上游（http://localhost:8787）
BASE_URL=http://localhost:3000

# 压测目标的鉴权令牌
# 打 new-api 时填 new-api 后台建的令牌（sk- 开头）
# 直打 mock 时随便填，mock 不校验
API_KEY=sk-your-new-api-token-here

# 混合流量抽哪些模型（逗号分隔，必须都在 new-api 渠道里配过）
# 例：gpt-6-astra,claude-opus-5,claude-sonnet-5
MODELS=gpt-6-astra,claude-sonnet-5

# ============================================================
# 场景参数（可选，不设则用默认值）
# ============================================================

# soak 场景（稳态测试）
SOAK_VUS=10          # 并发用户数
SOAK_DURATION=2m     # 持续时间

# stress 场景（压力测试）
STRESS_PEAK_VUS=200  # 峰值 VU

# spike 场景（尖峰测试）
SPIKE_VUS=100        # 冲击 VU

# mixed 场景（混合流量）
MIXED_RPS=3          # 目标 RPS
MIXED_DURATION=15s   # 持续时间
